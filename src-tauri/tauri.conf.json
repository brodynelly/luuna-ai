{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "LUUNA-AI",
	"version": "1.0.2",
	"identifier": "com.brodynelly.luuna-ai",
	"build": {
		"frontendDist": "../renderer"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "LUUNA-AI 1.0.2 Beta",
				"width": 1180,
				"height": 780,
				"minWidth": 760,
				"minHeight": 480,
				"center": true,
				"decorations": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
