    "components:setup": "node scripts/setup-components.mjs",
    "test:components": "cargo test --manifest-path src-tauri/Cargo.toml components_real -- --ignored --nocapture",
    "test:workbench": "node test/workbench-native-smoke.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
